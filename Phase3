Schema/ Query inorder to create a fact_table with dimension_table's dim_date, dim_company:-
==========================================================================================

"""
sudo kubectl exec -it -n datawarehouse deploy/postgres -- \
psql -U postgres -d DataWarehouse -c "
INSERT INTO warehouse.fact_stock_prices
(
    date_key,
    company_key,
    open_price,
    high_price,
    low_price,
    close_price,
    volume
)
SELECT
    d.date_key,
    c.company_key,
    s.open_price,
    s.high_price,
    s.low_price,
    s.close_price,
    s.volume
FROM staging.stock_prices s
JOIN warehouse.dim_date d
    ON d.full_date = s.date
JOIN warehouse.dim_company c
    ON c.ticker = s.ticker
WHERE s.open_price IS NOT NULL
  AND s.high_price IS NOT NULL
  AND s.low_price IS NOT NULL
  AND s.close_price IS NOT NULL
  AND s.volume IS NOT NULL
  AND s.open_price > 0
  AND s.high_price > 0
  AND s.low_price > 0
  AND s.close_price > 0
  AND s.volume >= 0
  AND s.high_price >= s.low_price
  AND s.high_price >= s.open_price
  AND s.high_price >= s.close_price
  AND s.low_price <= s.open_price
  AND s.low_price <= s.close_price
ON CONFLICT (date_key, company_key) DO NOTHING;
"
"""

