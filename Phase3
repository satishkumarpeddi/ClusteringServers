Creation Postgres:- 
=================

sudo kubectl exec -it -n datawarehouse deploy/postgres -- \
psql -U postgres -c "\l" --> It is used to get the schema for the existing datawarehouse 

sudo kubectl exec -it -n datawarehouse deploy/postgres -- \
psql -U postgres -c 'CREATE DATABASE "DataWareHouse";'

sudo kubectl exec -it -n datawarehouse deploy/postgres -- \ 
psql -U postgres -d Datawarehouse -c "SELECT version();"

sudo kubectl exec -it -n datawarehouse deploy/postgres -- \ 
psql -U postgres -d Datawarehouse -c "\dn"  ---> it is used to check the null value's 

cd ~ git clone https://github.com/satishkumarpeddi/DataWareHousing

cd DataWareHousing --> (find sql -maxdepth 1 -type f -print | sort)


To look over the contant in the files --> (for f in sql/*.sql; do echo "=========== $f ========="; head -20 "$f"; done)

"""

sudo kubectl cp warehouse-schema.sql \
datawarehouse/$(sudo kubectl get pod -n datawarehouse -l app=postgres -o jsonpath='{.items[0].metadata.name}'):/tmp/warehouse-schema.sql

sudo kubectl exec -it -n datawarehouse deploy/postgres -- \ psql -U postgres -d  DataWarehouse -f /tmp/warehouse-schema.sql --> (It is used to execute the schema)

sudo kubectl exec -it -n datawarehouse deploy/postgres -- \ psql -U postgres -d DataWarehouse -c "\dn"

=================================================================
/dt --> is for describe table's || /dv --> is for describe view's
=================================================================

sudo kubectl exec -it -n datawarehouse deploy/postgres -- \ psql -U postgres -d DataWarehouse -c "\dt staging.*"

sudo kubectl exec -it -n datawarehouse deploy/postgres -- \ psql -U postgres -d DataWarehouse -c "\dt warehouse.*"

sudo kubectl exec -it -n datawarehouse deploy/postgres -- \ psql -U postgres -d DataWarehouse -c "\dv analytics.*" --> It is for view's


